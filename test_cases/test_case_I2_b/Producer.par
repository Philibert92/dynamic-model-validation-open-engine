<parametersSet xmlns="http://www.rte-france.com/dynawo">
  
  <set id="OmegaRef">
    <par type="DOUBLE" name="setPoint_Value0" value="1"/>
  </set>  
  
  <!-- IDA order 2 solver -->
  <set id="IDA">
    <par type="INT" name="order" value="2"/>
    <par type="DOUBLE" name="initStep" value="1e-6"/>
    <par type="DOUBLE" name="minStep" value="1e-6"/>
    <par type="DOUBLE" name="maxStep" value="0.01"/>
    <par type="DOUBLE" name="absAccuracy" value="1e-6"/>
    <par type="DOUBLE" name="relAccuracy" value="1e-4"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="1e-6"/>
  </set>
  <!-- SIM solver -->
  <set id="SIM">
    <par type="DOUBLE" name="hMin" value="1e-6"/>
    <par type="DOUBLE" name="hMax" value="0.01"/>
    <par type="DOUBLE" name="kReduceStep" value="0.5"/>
    <par type="INT" name="maxNewtonTry" value="10"/>
    <par type="STRING" name="linearSolverName" value="KLU"/>
    <par type="DOUBLE" name="fnormtol" value="1e-4"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="1e-6"/>
  </set>
  <set id="InfiniteBus">
    <par type="DOUBLE" name="infiniteBus_UPu" value="1.0705555555555557"/>
    <par type="DOUBLE" name="infiniteBus_UPhase" value="0"/>
  </set>
  <set id="Line">
    <par type="DOUBLE" name="line_RPu" value="0.0"/>
    <par type="DOUBLE" name="line_XPu" value="0.32725925925925925"/>
    <par type="DOUBLE" name="line_BPu" value="0.0"/>
    <par type="DOUBLE" name="line_GPu" value="0.0"/>
  </set>
  
  <!-- For each generator defined in the producer's input files, a definition for its 
  setpoint model will be added, followed by a set of parameters specific to that setpoint 
  model. -->
  <set id="SetPoint_Wind_Turbine">
    <par type="DOUBLE" name="step_tStep" value="20.0"/>
    <par type="DOUBLE" name="step_Value0" value="1.0444516253201932"/>
    <par type="DOUBLE" name="step_Height" value="0.02088888888888889"/>
  </set>

  <set id="Wind_Turbine">
    <!-- Operating Point -->
    <par type="DOUBLE" name="WPP_P0Pu" value="-0.7500051564615615"/>
    <par type="DOUBLE" name="WPP_Q0Pu" value="-5.156461528321721e-06"/>
    <par type="DOUBLE" name="WPP_U0Pu" value="1.0444516253201932"/>
    <par type="DOUBLE" name="WPP_UPhase0" value="0.2213213175834554"/>
    <!-- 2.1 General Parameters -->
    <par type="DOUBLE" name="WPP_SNom" value="100"/>
    <par type="DOUBLE" name="WPP_tS" value="0.001"/>
    <!-- PCS-->
    <par type="BOOL" name="WPP_PPCLocal" value="true"/>
    <par type="DOUBLE" name="WPP_BMvHvPu" value="0"/>
    <par type="DOUBLE" name="WPP_GMvHvPu" value="0"/>
    <par type="DOUBLE" name="WPP_RMvHvPu" value="0.02"/>
    <par type="DOUBLE" name="WPP_XMvHvPu" value="0.1"/>
    <!-- LV Transformer -->
    <par type="BOOL" name="WPP_ConverterLVControl" value="true"/>
    <par type="DOUBLE" name="WPP_BLvTrPu" value="0"/>
    <par type="DOUBLE" name="WPP_GLvTrPu" value="0"/>
    <par type="DOUBLE" name="WPP_RLvTrPu" value="0.015"/>
    <par type="DOUBLE" name="WPP_XLvTrPu" value="0.06"/>
    <!-- Anti wind-up gain -->
    <!-- 2.2 Type 4 generator system module -->
    <par type="DOUBLE" name="WPP_tG" value="0.0036"/>
    <par type="DOUBLE" name="WPP_DipMaxPu" value="10"/>
    <par type="DOUBLE" name="WPP_DiqMaxPu" value="100"/>
    <par type="DOUBLE" name="WPP_DiqMinPu" value="-200"/>
    <par type="DOUBLE" name="WPP_Kipaw" value="100"/>
    <par type="DOUBLE" name="WPP_Kiqaw" value="100"/>
    <!-- 2.3 Reference frame rotation module -->
    <par type="DOUBLE" name="WPP_tPll" value="0.002"/>
    <par type="DOUBLE" name="WPP_UPll1Pu" value="0.25"/>
    <par type="DOUBLE" name="WPP_UPll2Pu" value="0.2"/>
    <!-- 2.4 P control module -->
    <par type="DOUBLE" name="WPP_tPOrdP4A" value="0.020275"/>
