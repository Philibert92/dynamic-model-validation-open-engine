<?xml version="1.0" encoding="UTF-8"?>
<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
    <!-- Benchmark Case -->
  <dyn:blackBoxModel id="InfiniteBus" lib="InfiniteBus" parFile="Producer.par" parId="InfiniteBus"/>
  <dyn:blackBoxModel id="Line" lib="Line" parFile="Producer.par" parId="Line"/>
  <dyn:blackBoxModel id="BusPDR" lib="Bus"/>
  <dyn:connect id1="Line" var1="line_terminal1" id2="InfiniteBus" var2="infiniteBus_terminal"/>
  <dyn:connect id1="Line" var1="line_terminal2" id2="BusPDR" var2="bus_terminal"/>
  <!-- For each generator defined within the producer's input files, two lines will be added to 
  the output. The first of these lines will define the setpoint model specifically for that 
  generator. The second line will establish the connection, linking the producer's generator model 
  with the newly defined setpoint model.-->
  <dyn:blackBoxModel id="SetPoint_Wind_Turbine" lib="Step" parFile="Producer.par" parId="SetPoint_Wind_Turbine"/>
  <dyn:connect id1="Wind_Turbine" var1="WPP_xWPRefPu" id2="SetPoint_Wind_Turbine" var2="step_step"/>
  <!-- Benchmark Case -->
  <dyn:blackBoxModel id="OmegaRef" lib="SetPoint" parFile="Producer.par" parId="OmegaRef"/>
  <dyn:connect id1="Wind_Turbine" var1="WPP_omegaRefPu" id2="OmegaRef" var2="setPoint_setPoint"/>
  <!-- Producer -->
   <dyn:blackBoxModel id="StepUp_Xfmr" lib="TransformerRatioTapChanger" parFile="Producer.par" parId="StepUp_Xfmr"/>
  <dyn:blackBoxModel id="Wind_Turbine" lib="IECWPP4ACurrentSource2020" parFile="Producer.par" parId="Wind_Turbine"/>
  <dyn:connect id1="StepUp_Xfmr" var1="transformer_terminal1" id2="BusPDR" var2="bus_terminal"/>
  <dyn:connect id1="Wind_Turbine" var1="WPP_terminal" id2="StepUp_Xfmr" var2="transformer_terminal2"/>
</dyn:dynamicModelsArchitecture>
