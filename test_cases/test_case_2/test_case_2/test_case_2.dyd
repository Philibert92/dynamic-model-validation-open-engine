<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:blackBoxModel id="InfiniteBus" lib="InfiniteBusFromTable" parFile="test_case_2.par" parId="InfiniteBus"/>
  <dyn:blackBoxModel id="GridFormingConverter" lib="GridFormingConverterDroopControl" parFile="test_case_2.par" parId="GridFormingConverter"/>
  <dyn:blackBoxModel id="OMEGA_REF" lib="DYNModelOmegaRef" parFile="test_case_2.par" parId="OmegaRef"/>
  <dyn:connect id1="GridFormingConverter" var1="converter_terminal" id2="InfiniteBus" var2="infiniteBus_terminal"/>
  <dyn:connect id1="OMEGA_REF" var1="omega_grp_0_value" id2="GridFormingConverter" var2="converter_omegaPu"/>
  <dyn:connect id1="OMEGA_REF" var1="omegaRef_grp_0_value" id2="GridFormingConverter" var2="control_omegaRefPu"/>
  <dyn:connect id1="OMEGA_REF" var1="running_grp_0" id2="GridFormingConverter" var2="converter_running"/> 
  
  <!--
  <dyn:connect id1="GridFormingConverter" var1="control_omegaRefPu" id2="InfiniteBus" var2="infiniteBus_omegaRefPu"/>
  
  -->
</dyn:dynamicModelsArchitecture>
